<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep scan history private locally; do not upload sensitive scans to cloud by default -->
        <exclude domain="database" path="scan_vault.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="scan_vault.db" />
    </device-transfer>
</data-extraction-rules>
